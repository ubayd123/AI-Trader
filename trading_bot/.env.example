# Copy to trading_bot/.env. Everything is optional: with no settings the bot
# paper-trades £50 using its built-in rules.

# ---- Capital and risk (defaults shown) ----
BOT_STARTING_CASH_GBP=50
BOT_MAX_POSITIONS=3
BOT_STOP_LOSS_PCT=0.10
BOT_TRAILING_STOP_PCT=0.20
BOT_MAX_DRAWDOWN_PCT=0.25
# No new buys while the S&P 500 is below its 200-day average.
BOT_REGIME_FILTER=true
# Comma-separated market:symbol pairs. Markets: us-stock, crypto (paper only).
# BOT_WATCHLIST=us-stock:AAPL,us-stock:MSFT,crypto:BTC

# ---- Claude advisor (optional) ----
# Get a key at https://console.anthropic.com. Costs a few pence per cycle.
ANTHROPIC_API_KEY=
BOT_AI_ENABLED=true
BOT_AI_NEWS=true

# ---- Broker ----
# paper       = simulated fills (default)
# trading212  = Trading 212 Invest / Stocks ISA. Use demo first.
BOT_BROKER=paper
BOT_T212_ENV=demo
T212_API_KEY=
T212_API_SECRET=

# ---- AI-Trader platform sync (optional) ----
# Run `python -m trading_bot register <name>` to get a token.
BOT_PLATFORM_URL=https://ai4trade.ai/api
AI4TRADE_TOKEN=

# ============================================================
# Rapid intraday bot (python -m trading_bot day ...). See trading_bot/day/README.md
# ============================================================
# ig (spread betting, the default) or etoro (real shares)
DAY_BROKER=ig
# rapid or selective
DAY_PRESET=rapid
# The bot's budget in pounds. IG cannot be traded with 50: see the README.
DAY_BUDGET_GBP=50
DAY_DAILY_LOSS_LIMIT_PCT=0.02
DAY_MAX_TRADES_PER_DAY=100
DAY_RISK_PER_TRADE_PCT=0.0025
# DAY_SYMBOLS=US500,GBPUSD

# ---- IG demo account (My IG > Settings > API keys) ----
IG_USERNAME=
IG_PASSWORD=
IG_API_KEY=
IG_ACCOUNT_ID=
# ---- IG real account, only used with --real --confirm-live ----
IG_REAL_USERNAME=
IG_REAL_PASSWORD=
IG_REAL_API_KEY=

# ---- eToro (only with DAY_BROKER=etoro). Settings > Trading > API Key Management ----
ETORO_API_KEY=
ETORO_USER_KEY=
