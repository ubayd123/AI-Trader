# Copy to trading_bot/.env. Everything is optional: with no settings the bot
# paper-trades £50 using its built-in rules.

# ---- Capital and risk (defaults shown) ----
BOT_STARTING_CASH_GBP=50
BOT_MAX_POSITIONS=3
BOT_STOP_LOSS_PCT=0.10
BOT_TRAILING_STOP_PCT=0.20
BOT_MAX_DRAWDOWN_PCT=0.25
# No new buys while the S&P 500 is below its 200-day average.
BOT_REGIME_FILTER=true
# Comma-separated market:symbol pairs. Markets: us-stock, crypto (paper only).
# BOT_WATCHLIST=us-stock:AAPL,us-stock:MSFT,crypto:BTC

# ---- Claude advisor (optional) ----
# Get a key at https://console.anthropic.com. Costs a few pence per cycle.
ANTHROPIC_API_KEY=
BOT_AI_ENABLED=true
BOT_AI_NEWS=true

# ---- Broker ----
# paper       = simulated fills (default)
# trading212  = Trading 212 Invest / Stocks ISA. Use demo first.
BOT_BROKER=paper
BOT_T212_ENV=demo
T212_API_KEY=
T212_API_SECRET=

# ---- AI-Trader platform sync (optional) ----
# Run `python -m trading_bot register <name>` to get a token.
BOT_PLATFORM_URL=https://ai4trade.ai/api
AI4TRADE_TOKEN=
